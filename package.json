{
  "name": "manager-multi-profile",
  "version": "1.0.3",
  "private": true,
  "author": "Personal Desktop App",
  "description": "Manager Multi Profile — quản lý nhiều profile trình duyệt, nhóm tài khoản, lưu database/cookies và cài đặt extension hàng loạt (hỗ trợ đăng nhập & treo tài khoản TikTok).",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "cloakbrowser": "0.5.7",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "41.10.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "vn.anti.managermultiprofile",
    "productName": "Manager Multi Profile",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "!assets/icon-preview.png",
      "third-party/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Manager Multi Profile"
    }
  }
}
